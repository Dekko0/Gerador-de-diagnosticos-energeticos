# ======================================================================
# Regras específicas do projeto (Gerador de Diagnósticos)
# ======================================================================

# Saídas geradas
output/*.docx
output/*.pdf

# Tectonic — binário portátil não versionado (~50 MB). Baixe em
# github.com/tectonic-typesetting/tectonic/releases e coloque em bin/.
# No Streamlit Cloud, o Tectonic é instalado via packages.txt (apt).
bin/*
!bin/.gitkeep

# Temporários do projeto
_*.py
_*.png
*.tmp

# Template original (fonte; o app usa templates/latex/)
# (mantido no repo — descomente se quiser excluir)
# Modelo_Relatório_Prefeitura/

# ======================================================================
# Template padrão de Python (GitHub)
# ======================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

