# Ambiente virtual
.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Saídas geradas
output/*.docx
output/*.pdf

# Tectonic — binário portátil não versionado (~50 MB). Baixe em
# github.com/tectonic-typesetting/tectonic/releases e coloque em bin/.
bin/*
!bin/.gitkeep

# Temporários
_*.py
_*.png
*.tmp

